# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/crazygrowmind

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer - SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=infocrzygrowmindstudio@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CrazyGrowMind Studio <infocrzygrowmindstudio@gmail.com>"

# Default Admin (used by seed script)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@crazygrowmind.com
ADMIN_PASSWORD=Admin@12345
